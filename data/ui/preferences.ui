                        <property name="halign">start</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Click the compact stack to smoothly expand items. Click the stack handle or outside the dock to collapse it back.</property>
                        <attributes>
                          <attribute name="scale" value="0.85" />
                        </attributes>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">9</property>
                        <property name="width">4</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="name">effects</property>
                    <property name="title" translatable="yes">Effects</property>
                    <property name="position">3</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="page_items">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                  </object>
                  <packing>
                    <property name="name">items</property>
                    <property name="title" translatable="yes">Items</property>
                    <property name="position">4</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="sw_docklets">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="hscrollbar_policy">never</property>
                    <child>
                      <object class="GtkIconView" id="view_docklets">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="margin">6</property>
                        <property name="columns">3</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">docklets</property>
                    <property name="title" translatable="yes">Docklets</property>
                    <property name="position">5</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="headerbar">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="show_close_button">True</property>
        <property name="title" translatable="yes">Plank Preferences</property>
      </object>
    </child>
  </template>
</interface>
